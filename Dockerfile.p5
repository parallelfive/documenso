# Parallel Five custom Documenso image — full source build.
#
# Why source build instead of FROM upstream + COPY overlays:
#   Documenso is Node + TypeScript, bundled at build time by Turbo + Remix.
#   You can't COPY a .ts file into a prebuilt image and expect it to take
#   effect — it has to be re-compiled into the bundle. So we publish a
#   fresh image built from our patched source tree.
#
# This file is a thin wrapper around upstream's docker/Dockerfile so that
# any upstream changes to the build pipeline flow through automatically
# on rebase. Patches live in the source tree itself (apps/, packages/),
# not as overlays.
#
# Build:    ghcr.io/parallelfive/documenso:latest
# Built by: .github/workflows/build-p5-image.yml on push to p5/patched +
#           weekly cron (Mondays 06:00 UTC) + manual dispatch.
# Patch manifest: P5_PATCHES.md
#
# Pattern matches our parallelfive/coolify fork in spirit (fork + GHCR
# image), but the mechanism differs: Coolify is PHP so it overlays files;
# Documenso must rebuild from source.

# syntax=docker/dockerfile:1
# hadolint ignore=DL3007
FROM scratch
# Real build happens via the upstream docker/Dockerfile, referenced from
# build-p5-image.yml's `file:` parameter. This file exists as the documented
# build entry point + so `docker build -f Dockerfile.p5 .` from the repo root
# fails fast with a clear error rather than silently producing an empty image.
LABEL org.opencontainers.image.source="https://github.com/parallelfive/documenso"
LABEL org.opencontainers.image.description="Build via docker/Dockerfile from p5/patched — see Dockerfile.p5 + .github/workflows/build-p5-image.yml"
